<Window x:Class="Serein.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Serein" Width="1240" Height="820" ResizeMode="CanMinimize" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Viewbox x:Name="RootViewport" Stretch="Uniform" StretchDirection="DownOnly"><Grid x:Name="RootSurface" Width="1240" Height="820" Background="{DynamicResource CanvasBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0"><DockPanel Margin="16,23,16,18">
      <StackPanel DockPanel.Dock="Top" Margin="12,0,0,26"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0"><TextBlock Text="S" FontFamily="Segoe UI" FontWeight="Bold" Foreground="{DynamicResource AccentInkBrush}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock Text="Serein" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="SidebarCaption" Text="PERFORMANCE WORKSPACE" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="1,10,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0"><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14"><StackPanel><TextBlock x:Name="ProfileCaption" Text="ТЕКУЩИЙ ПРОФИЛЬ" FontSize="9" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="SideMode" Text="Balanced" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,7,0,0"/><TextBlock x:Name="SideSession" Text="Сессия не запущена" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border></StackPanel>
      <ListBox x:Name="Navigation" SelectionChanged="Navigate" AutomationProperties.Name="Navigation" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    </DockPanel></Border>
    <Grid Grid.Column="1"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource ThemeToggleButtonStyle}" Click="ThemeClick" ToolTip="Светлая / тёмная тема" AutomationProperties.Name="Toggle theme"/><Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" Click="MinimizeClick" ToolTip="Свернуть" AutomationProperties.Name="Minimize"/><Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE8BB;" Click="CloseClick" ToolTip="Закрыть" AutomationProperties.Name="Close"/></StackPanel></Grid>
    <Grid Grid.Column="1" Grid.Row="1" Margin="28,12,28,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PageTitle" Text="Обзор" FontSize="29" FontWeight="SemiBold"/><Button x:Name="RestoreButton" Grid.Column="1" Content="Восстановить всё" Click="RestoreClick" Margin="0" Padding="14,8" VerticalAlignment="Center"/></Grid>
      <TextBlock x:Name="PageSubtitle" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,22"/>
      <ContentControl x:Name="PageBody" Grid.Row="2"/>
      <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,11,0,0"><TextBlock x:Name="StatusLine" Text="Запуск…" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}" FontSize="10" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></Border>
    </Grid>
  </Grid></Viewbox>
</Window>

<Application x:Class="Serein_Gaming_WinUI.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
     <SolidColorBrush x:Key="CanvasBrush" Color="#101114" />
     <SolidColorBrush x:Key="RailBrush" Color="#17191E" />
     <SolidColorBrush x:Key="SurfaceBrush" Color="#191C22" />
     <SolidColorBrush x:Key="LineBrush" Color="#292D36" />
     <SolidColorBrush x:Key="InkBrush" Color="#EEEFF7" />
     <SolidColorBrush x:Key="MutedBrush" Color="#A3A9BA" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="CanvasBrush" Color="#F3F4F8" />
     <SolidColorBrush x:Key="RailBrush" Color="#EAECF2" />
     <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
     <SolidColorBrush x:Key="LineBrush" Color="#D8DBE5" />
     <SolidColorBrush x:Key="InkBrush" Color="#1A1D2B" />
     <SolidColorBrush x:Key="MutedBrush" Color="#596174" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="CanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
     <SolidColorBrush x:Key="RailBrush" Color="{ThemeResource SystemColorWindowColor}" />
     <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
     <SolidColorBrush x:Key="LineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="InkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <DataTemplate x:Key="InstalledGameTemplate">
    <StackPanel Spacing="4" Padding="8,9">
     <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
     <TextBlock Text="{Binding Source}" FontSize="12" Opacity="0.7" />
    </StackPanel>
   </DataTemplate>
   <Color x:Key="SystemAccentColor">#AE9CF7</Color>
   <SolidColorBrush x:Key="AccentBrush" Color="#AE9CF7" />
   <Style TargetType="Button"><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="18,11" /><Setter Property="FontSize" Value="14" /></Style>
   <Style TargetType="ToggleButton"><Setter Property="CornerRadius" Value="9" /><Setter Property="Padding" Value="16,10" /></Style>
   <x:Double x:Key="BodyTextSize">14</x:Double>
   <x:Double x:Key="CaptionTextSize">12</x:Double>
   <x:Double x:Key="SmallTextSize">11</x:Double>
   <DataTemplate x:Key="ProcessTemplate">
    <Grid ColumnSpacing="16" Padding="8,10">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
     <StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{ThemeResource BodyTextSize}" /><TextBlock Text="{Binding Location}" Foreground="{ThemeResource MutedBrush}" FontSize="{ThemeResource SmallTextSize}" TextTrimming="CharacterEllipsis" /></StackPanel>
     <TextBlock Grid.Column="1" Text="{Binding Pid}" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}" FontSize="{ThemeResource CaptionTextSize}" />
     <TextBlock Grid.Column="2" Text="{Binding Cpu}" VerticalAlignment="Center" FontSize="{ThemeResource BodyTextSize}" />
     <TextBlock Grid.Column="3" Text="{Binding Memory}" VerticalAlignment="Center" FontSize="{ThemeResource BodyTextSize}" />
     <TextBlock Grid.Column="4" Text="{Binding Status}" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}" FontSize="{ThemeResource CaptionTextSize}" />
    </Grid>
   </DataTemplate>
   <DataTemplate x:Key="DeviceComponentTemplate">
    <Grid Padding="8,12" ColumnSpacing="14">
     <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <FontIcon Glyph="{Binding Glyph}" FontSize="22" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Spacing="5">
      <TextBlock Text="{Binding Name}" FontSize="{ThemeResource BodyTextSize}" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Caption}" FontSize="{ThemeResource CaptionTextSize}" Foreground="{ThemeResource MutedBrush}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Status}" FontSize="{ThemeResource SmallTextSize}" Foreground="{ThemeResource MutedBrush}"/>
     </StackPanel>
    </Grid>
   </DataTemplate>
  </ResourceDictionary>
 </Application.Resources>
</Application>
